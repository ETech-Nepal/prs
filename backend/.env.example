# PRS backend (docker-compose.yml). Copy to backend/.env.
PORT=4300
# Exact origin of the PRS UI, e.g. https://prs-<secret>.103.90.84.17.sslip.io
CORS_ORIGIN=https://prs-CHANGE-ME.103.90.84.17.sslip.io
# OpenHIM transaction port, plain HTTP inside the openhim network.
OPENHIM_TX_URL=http://openhim-core:5001
# Must equal PUBLIC_BASE_URL in openhim_single/.env (DPoP proofs name it).
OPENHIM_PUBLIC_BASE_URL=https://openhim.103.90.84.17.sslip.io
# Keycloak inside the network, and the issuer exactly as in tokens (= KEYCLOAK_ISSUER in openhim_single/.env).
KEYCLOAK_TOKEN_URL=http://keycloak:8080/realms/openhie/protocol/openid-connect/token
KEYCLOAK_ISSUER=https://keycloak.103.90.84.17.sslip.io/realms/openhie
PRS_CLIENT_ID=prs-portal
